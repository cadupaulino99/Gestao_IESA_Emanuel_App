rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) 
        ? get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role 
        : null;
    }

    // Check if the current user is an admin.
    // O papel vem UNICAMENTE do documento admins/<email> (auditoria 2026-10-24).
    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    // Super admin: flag isSuper no documento (ou o email fundador ATÉ a migração
    // criar a flag). Só ele gere contas de admin — no servidor, não só no UI.
    function isSuperAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.isSuper == true) ||
        request.auth.token.email == "Cadupaulino99@gmail.com" ||
        request.auth.token.email == "cadupaulino99@gmail.com"
      );
    }

    // Bootstrap AUTO-EXTINGUÍVEL: enquanto não existir admins/<email do fundador>,
    // esse email pode criar o PRÓPRIO documento (uma vez). Depois morre para sempre.
    function isBootstrapCreate(adminId) {
      return isAuthenticated() &&
        (request.auth.token.email == "Cadupaulino99@gmail.com" ||
         request.auth.token.email == "cadupaulino99@gmail.com") &&
        adminId == request.auth.token.email &&
        !exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    function isTreasurer() {
      return isAuthenticated() && getRole() == 'treasurer';
    }
    function isPastor() {
       return isAuthenticated() && getRole() == 'pastor';
    }
    function hasFinancialWriteAccess() {
       return isAdmin() || isTreasurer() || isPastor();
    }

    function isValidId(id) {
      return id is string && id.size() > 0;
    }

    // --- Auditoria de segurança 2026-10-24 ---
    // Leituras de documentos POR MEMBRO: o próprio (comparando memberEmail com o
    // email do token) ou a liderança. Documentos ANTIGOS (sem memberEmail,
    // gravados antes desta auditoria) mantêm a leitura autenticada para não
    // partir o portal de ninguém — migração natural: cada novo registo já leva
    // memberEmail.
    function isOwnMemberDoc() {
      return isAuthenticated()
        && resource.data.keys().hasAll(['memberEmail'])
        && resource.data.memberEmail == request.auth.token.email;
    }
    function isLegacyMemberDoc() {
      return isAuthenticated() && (
        !resource.data.keys().hasAll(['memberEmail']) ||
        resource.data.memberEmail == null
      );
    }
    function canReadMemberDoc() {
      return hasFinancialWriteAccess() || isOwnMemberDoc() || isLegacyMemberDoc();
    }

    // Edição dos próprios dados pelo membro: só um subconjunto de campos de
    // contacto/estado, todos strings, + updatedAt. Nome, BI, estado de membro,
    // dízimos etc. continuam reservados à liderança.
    function isSelf() {
      return isAuthenticated() && resource.data.email == request.auth.token.email;
    }
    // v1.14: o membro só desliga a própria marca de troca obrigatória de
    // palavra-passe (depois de definir a definitiva no 1.º login). Só para
    // `false` — reactivar a marca é coisa da liderança.
    function isSelfFlagClear() {
      return isSelf() &&
        incoming().diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt']) &&
        incoming().mustChangePassword == false;
    }

    function isSelfEdit() {
      return isSelf() &&
        incoming().keys().hasOnly(['phone', 'address', 'maritalStatus', 'education', 'profession', 'spouseName', 'updatedAt']) &&
        incoming().phone is string &&
        incoming().address is string &&
        incoming().maritalStatus is string &&
        incoming().education is string &&
        incoming().profession is string &&
        incoming().spouseName is string &&
        incoming().updatedAt is number;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Admin Collection ---
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) && data.keys().size() <= 10 &&
             data.email is string && data.email.size() <= 200 && data.email.size() > 0 &&
             data.role is string &&
             data.createdAt is number;
    }

    // O próprio só pode tocar nestes dois campos (último login e troca da
    // palavra-passe temporária). Nada mais.
    function isSelfAdminFieldUpdate() {
      return isAuthenticated() &&
             request.auth.token.email == resource.data.email &&
             incoming().keys().hasOnly(['lastLoginAt', 'mustChangePassword']) &&
             (incoming().lastLoginAt is number || incoming().mustChangePassword is bool);
    }

    match /admins/{adminId} {
      // ler a si próprio (login/portal) ou ao super; listar: só super
      allow read: if isAuthenticated() && (request.auth.token.email == adminId || isSuperAdmin());
      allow create: if isValidId(adminId) && isValidAdmin(incoming()) &&
                    (isSuperAdmin() || isBootstrapCreate(adminId));
      allow update: if isSuperAdmin() || isSelfAdminFieldUpdate();
      allow delete: if isSuperAdmin();
      allow list: if isSuperAdmin();
    }

    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- v1.11.0: orçamento único, contribuições, pagamentos ---
    // Escrita: só liderança (servidor). Leitura: o próprio membro ou liderança.
    function isOwnOrLeader() {
      return hasFinancialWriteAccess() || isOwnMemberDoc();
    }

    match /member_budgets/{docId} {
      allow read, list: if isOwnOrLeader();
      allow create, update: if isAdmin() && isValidId(docId)
                            && incoming().keys().hasAll(['memberId', 'year', 'amount', 'setBy', 'setAt', 'history'])
                            && incoming().amount is int && incoming().amount > 0;
      allow delete: if hasFinancialWriteAccess();
    }

    match /contributions/{docId} {
      allow read, list: if isOwnOrLeader();
      allow create: if isAdmin() && isValidId(docId)
                    && incoming().keys().hasAll(['memberId', 'description', 'amount', 'dueDate', 'status', 'setBy', 'setAt', 'history'])
                    && incoming().amount is int && incoming().amount > 0
                    && incoming().description is string && incoming().description.size() > 0
                    && incoming().dueDate is string;
      allow update: if hasFinancialWriteAccess();
      allow delete: if hasFinancialWriteAccess();
    }

    match /contribution_payments/{docId} {
      allow read, list: if isOwnOrLeader();
      allow create: if isAdmin() && isValidId(docId)
                    && incoming().keys().hasAll(['contributionId', 'memberId', 'amount', 'deliveryDate', 'recordedBy', 'createdAt'])
                    && incoming().amount is int && incoming().amount > 0;
      allow update, delete: if hasFinancialWriteAccess();
    }

    // --- Notificações por utilizador: cada um vê só as suas; liderança cria ---
    match /notifications/{docId} {
      allow read, list: if isAuthenticated() && resource.data.userEmail == request.auth.token.email;
      allow create: if hasFinancialWriteAccess() || (isAuthenticated() && incoming().userEmail == request.auth.token.email);
      // O dono marca como lida; a liderança (v1.13) actualiza APENAS os
      // documentos do digest do módulo (kind == 'board'), campos limitados.
      allow update: if (isAuthenticated() && resource.data.userEmail == request.auth.token.email
                    && incoming().diff(resource.data).affectedKeys().hasOnly(['read']))
                    || (hasFinancialWriteAccess() && resource.data.kind == 'board'
                    && incoming().diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'refId', 'read', 'createdAt', 'updatedAt', 'byEmail']));
      allow delete: if isAuthenticated() && resource.data.userEmail == request.auth.token.email;
    }

    // --- Fila de mensagens externas (SMS/WhatsApp) e campanhas ---
    match /message_outbox/{docId} {
      allow read, list: if hasFinancialWriteAccess();
      allow create: if (isAdmin() && isValidId(docId))
                    // v1.13: a liderança enfileira o digest «board» (avisos/
                    // eventos) quando marca «enviar também por SMS/WhatsApp».
                    || (hasFinancialWriteAccess() && incoming().kind == 'board');
      allow update: if isAdmin() && isValidId(docId);
      allow delete: if hasFinancialWriteAccess();
    }

    match /campaigns/{docId} {
      allow read, list: if hasFinancialWriteAccess();
      allow create, update: if isAdmin() && isValidId(docId);
      allow delete: if false;
    }

    // --- Cartão de membro: comunhão, donativos voluntários, renovações ---
    // Leitura: qualquer sessão (o portal do membro filtra pelo próprio memberId
    // no cliente, tal como já faz com `tithes`). Escrita: só liderança.
    match /communions/{docId} {
      allow read, list: if canReadMemberDoc();
      allow create: if hasFinancialWriteAccess() && isValidId(docId)
                    && incoming().keys().hasAll(['memberId', 'year', 'month', 'mark']);
      allow update, delete: if hasFinancialWriteAccess();
    }

    match /donations/{docId} {
      allow read, list: if canReadMemberDoc();
      allow create: if hasFinancialWriteAccess() && isValidId(docId)
                    && incoming().keys().hasAll(['memberId', 'amount', 'date'])
                    && incoming().amount is int && incoming().amount > 0;
      allow update, delete: if hasFinancialWriteAccess();
    }

    match /renewals/{docId} {
      allow read, list: if isAuthenticated();
      allow create: if hasFinancialWriteAccess() && isValidId(docId)
                    && incoming().keys().hasAll(['memberId', 'date']);
      allow update, delete: if hasFinancialWriteAccess();
    }

    // --- Member Collection ---
    function isValidMemberCreate(data) {
      return data.keys().hasAll(['name', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (data.get('birthDate', '') is string) &&
             (data.get('gender', '') is string) &&
             (data.get('maritalStatus', '') is string) &&
             (data.get('spouseName', '') is string) &&
             (data.get('groupCell', '') is string) &&
             (data.get('education', '') is string) &&
             (data.get('profession', '') is string) &&
             (data.get('phone', '') is string) &&
             (data.get('address', '') is string) &&
             (data.get('status', '') is string);
    }

    function isValidMemberUpdate(data) {
       return data.keys() == existing().keys() || true; // Weak validation, rely on hasOnly in action
    }

    match /members/{memberId} {
      allow read, list: if isAuthenticated();
      allow create: if hasFinancialWriteAccess() && isValidId(memberId);
      // O próprio membro (conta com o mesmo email) pode editar um subconjunto
      // seguro dos seus dados — sugestão da liderança (2026-10-23).
      allow update: if (hasFinancialWriteAccess() && isValidId(memberId)) || isSelfEdit() || isSelfFlagClear();
      allow delete: if hasFinancialWriteAccess() && isValidId(memberId);
    }

    // --- Tithe Collection ---
    function isValidTitheCreate(data) {
      return data.keys().hasAll(['memberId', 'month', 'year', 'amount', 'receiptNumber', 'adminId', 'createdAt', 'updatedAt',
                                 'deliveryMonth', 'deliveryYear', 'referenceMonth', 'referenceYear']) &&
             data.keys().size() <= 18 &&
             data.memberId is string && data.memberId.size() > 0 &&
             data.month is string && data.month.size() > 0 &&
             data.year is number &&
             data.amount is int &&
             data.receiptNumber is string &&
             (data.get('referenceMonth', '') is string) &&
             (data.get('referenceYear', 0) is number) &&
             (data.get('deliveryMonth', '') is string) &&
             (data.get('deliveryYear', 0) is number) &&
             (data.get('cashierMonth', '') is string) &&
             (data.get('cashierYear', 0) is number) &&
             (data.get('contributionType', '') is string) &&
             (data.get('contributionDetail', '') is string) &&
             data.adminId is string && data.adminId == request.auth.uid &&
             data.createdAt is number && data.updatedAt is number;
    }

    match /tithes/{titheId} {
      allow read, list: if canReadMemberDoc();
      allow create: if hasFinancialWriteAccess() && isValidId(titheId) &&
                    isValidTitheCreate(incoming()) &&
                    exists(/databases/$(database)/documents/members/$(incoming().memberId));
      allow update: if hasFinancialWriteAccess() && isValidId(titheId) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().memberId == existing().memberId &&
                    incoming().adminId == existing().adminId &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'memberId', 'month', 'year', 'amount', 'receiptNumber', 'referenceMonth', 'referenceYear', 'contributionType', 'contributionDetail', 'updatedAt'
                    ]) &&
                    (incoming().month == null || incoming().month is string) && 
                    (incoming().year == null || incoming().year is number) &&
                    (incoming().amount == null || incoming().amount is int);
      allow delete: if hasFinancialWriteAccess() && isValidId(titheId);
    }

    // --- Offering Collection ---
    function isValidOfferingCreate(data) {
      return data.keys().hasAll(['description', 'type', 'month', 'year', 'amount', 'adminId', 'createdAt', 'updatedAt']) &&
             (data.keys().size() >= 8 && data.keys().size() <= 10) &&
             data.description is string && data.description.size() > 0 &&
             data.type is string && data.type.size() > 0 &&
             data.month is string && data.month.size() > 0 &&
             data.year is number &&
             data.amount is int &&
             (data.get('receiptNumber', '') is string) &&
             (data.get('referenceDate', '') is string) &&
             data.adminId is string && data.adminId == request.auth.uid &&
             data.createdAt is number && data.updatedAt is number;
    }

    match /offerings/{offeringId} {
      allow read, list: if hasFinancialWriteAccess();
      allow create: if hasFinancialWriteAccess() && isValidId(offeringId) && isValidOfferingCreate(incoming());
      allow update: if hasFinancialWriteAccess() && isValidId(offeringId) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().adminId == existing().adminId &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'description', 'type', 'month', 'year', 'amount', 'receiptNumber', 'referenceDate', 'updatedAt'
                    ]) &&
                    incoming().description is string && incoming().type is string && incoming().month is string && incoming().year is number && incoming().amount is int;
      allow delete: if hasFinancialWriteAccess() && isValidId(offeringId);
    }

    // --- Expense Collection ---
    function isValidExpenseCreate(data) {
      return data.keys().hasAll(['description', 'category', 'responsible', 'month', 'year', 'amount', 'adminId', 'createdAt', 'updatedAt']) &&
             (data.keys().size() == 9 || data.keys().size() == 10) &&
             data.description is string && data.description.size() > 0 &&
             data.category is string && data.category.size() > 0 &&
             (data.get('subCategory', '') is string) &&
             data.responsible is string && data.responsible.size() > 0 &&
             data.month is string && data.month.size() > 0 &&
             data.year is number &&
             data.amount is int &&
             data.adminId is string && data.adminId == request.auth.uid &&
             data.createdAt is number && data.updatedAt is number;
    }

    match /expenses/{expenseId} {
      allow read, list: if hasFinancialWriteAccess();
      allow create: if hasFinancialWriteAccess() && isValidId(expenseId) && isValidExpenseCreate(incoming());
      allow update: if hasFinancialWriteAccess() && isValidId(expenseId) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().adminId == existing().adminId &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'description', 'category', 'subCategory', 'responsible', 'month', 'year', 'amount', 'updatedAt'
                    ]) &&
                     incoming().description is string && incoming().category is string && incoming().responsible is string && incoming().month is string && incoming().year is number && incoming().amount is int;
      allow delete: if hasFinancialWriteAccess() && isValidId(expenseId);
    }

    // --- Building Fund Collection ---
    function isValidBuildingFundCreate(data) {
      return data.keys().hasAll(['description', 'type', 'amount', 'date', 'adminId', 'createdAt', 'updatedAt']) && data.keys().size() == 7 &&
             data.description is string && data.description.size() > 0 &&
             data.type is string && (data.type == 'IN' || data.type == 'OUT') &&
             data.amount is int &&
             data.date is string && data.date.size() > 0 &&
             data.adminId is string && data.adminId == request.auth.uid &&
             data.createdAt is number && data.updatedAt is number;
    }

    match /buildingFunds/{fundId} {
      allow read, list: if hasFinancialWriteAccess();
      allow create: if hasFinancialWriteAccess() && isValidId(fundId) && isValidBuildingFundCreate(incoming());
      allow update: if hasFinancialWriteAccess() && isValidId(fundId) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().adminId == existing().adminId &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'description', 'type', 'amount', 'date', 'updatedAt'
                    ]) &&
                     incoming().description is string && incoming().type is string && incoming().amount is int && incoming().date is string;
      allow delete: if hasFinancialWriteAccess() && isValidId(fundId);
    }

    // --- Asset Collection ---
    function isValidAssetCreate(data) {
      return data.keys().hasAll(['name', 'category', 'acquisitionDate', 'purchaseValue', 'adminId', 'createdAt', 'updatedAt']) &&
             (data.keys().size() == 7 || data.keys().size() == 8) &&
             data.name is string && data.name.size() > 0 &&
             data.category is string && data.category.size() > 0 &&
             data.acquisitionDate is string && data.acquisitionDate.size() > 0 &&
             data.purchaseValue is int &&
             (data.get('currentRate', 0) is number) &&
             data.adminId is string && data.adminId == request.auth.uid &&
             data.createdAt is number && data.updatedAt is number;
    }

    match /assets/{assetId} {
      allow read, list: if hasFinancialWriteAccess();
      allow create: if hasFinancialWriteAccess() && isValidId(assetId) && isValidAssetCreate(incoming());
      allow update: if hasFinancialWriteAccess() && isValidId(assetId) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().adminId == existing().adminId &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'name', 'category', 'acquisitionDate', 'purchaseValue', 'currentRate', 'updatedAt'
                    ]) &&
                     incoming().name is string && incoming().category is string && incoming().acquisitionDate is string && incoming().purchaseValue is number;
      allow delete: if hasFinancialWriteAccess() && isValidId(assetId);
    }
    // --- Financial Month Collection ---
    function isValidFinancialMonthCreate(data) {
      return data.keys().hasAll(['month', 'year', 'status', 'openingBalance', 'adminId', 'createdAt', 'updatedAt']) &&
             (data.keys().size() == 7 || data.keys().size() == 9 || data.keys().size() == 8) &&
             data.month is string && data.month.size() > 0 &&
             data.year is number &&
             data.status is string && (data.status == 'open' || data.status == 'closed') &&
             data.openingBalance is int &&
             (data.get('closingBalance', 0) is int) &&
             (data.get('closedAt', 0) is number) &&
             data.adminId is string && data.adminId == request.auth.uid &&
             data.createdAt is number && data.updatedAt is number;
    }

    match /financialMonths/{monthId} {
      allow read, list: if hasFinancialWriteAccess();
      allow create: if hasFinancialWriteAccess() && isValidId(monthId) && isValidFinancialMonthCreate(incoming());
      allow update: if hasFinancialWriteAccess() && isValidId(monthId) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().adminId == existing().adminId &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status', 'closingBalance', 'closedAt', 'updatedAt'
                    ]) &&
                    incoming().status is string && (incoming().status == 'open' || incoming().status == 'closed');
      allow delete: if hasFinancialWriteAccess() && isValidId(monthId);
    }
    // --- Financial Year Collection ---
    match /financialYears/{yearId} {
      allow read, list: if hasFinancialWriteAccess();
      allow create, update: if hasFinancialWriteAccess();
      allow delete: if isAdmin();
    }
    // --- Budget Collection ---
    match /budgets/{budgetId} {
      allow read: if hasFinancialWriteAccess();
      allow create, update: if hasFinancialWriteAccess();
      allow delete: if isAdmin();
    }
    match /expense_receipts/{receiptId} {
      allow read: if hasFinancialWriteAccess();
      allow create, update: if hasFinancialWriteAccess();
      allow delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read, list: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    // --- v1.13.0: Avisos, Agenda e Eventos -----------------------------
    // Publicação: LIDERANÇA (admin/pastor/tesoureiro) — decisão de 2026-10-25.
    // Membros: só LEITURA (o Portal lê as mesmas colecções — fonte única).
    function canPublishBoard() {
      return hasFinancialWriteAccess();
    }
    function hasField(d, k) {
      return d.keys().hasAny([k]);
    }
    function isDateIsoStr(s) {
      return s is string && s.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }
    function isTimeHHMMStr(s) {
      return s is string && s.matches('^(0\\d|1\\d|2[0-3]):[0-5]\\d$');
    }
    // Texto formatado: o editor/client já saneia (allowlist), mas o SERVIDOR
    // é a autoridade — recusa padrões perigosos mesmo em pedido directo.
    function isSafeRichText(s) {
      return s is string && s.size() <= 20000 &&
        !s.matches('(?is).*<\\s*script.*') &&
        !s.matches('(?is).*<\\s*iframe.*') &&
        !s.matches('(?is).*<\\s*style.*') &&
        !s.matches('(?is).*<\\s*object.*') &&
        !s.matches('(?is).*<\\s*embed.*') &&
        !s.matches('(?is).*<\\s*svg.*') &&
        !s.matches('(?is).*javascript\\s*:.*') &&
        !s.matches('(?is).*on(load|error|click|mouseover|focus|blur)\\s*=.*');
    }
    function isValidAnnouncementDoc(d) {
      return d.keys().hasAll(['title']) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
        (!hasField(d, 'content') || d.content is string) &&
        (!hasField(d, 'contentHtml') || isSafeRichText(d.contentHtml)) &&
        (!hasField(d, 'level') || d.level in ['normal', 'urgente']) &&
        (!hasField(d, 'status') || d.status in ['rascunho', 'publicado', 'arquivado']) &&
        (!hasField(d, 'pinned') || d.pinned is bool) &&
        (!hasField(d, 'visibleUntil') || d.visibleUntil == null || isDateIsoStr(d.visibleUntil)) &&
        (!hasField(d, 'active') || d.active is bool);
    }
    function isValidEventDoc(d) {
      return d.keys().hasAll(['title', 'date']) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
        isDateIsoStr(d.date) &&
        (!hasField(d, 'time') || d.time == null || d.time == '' || isTimeHHMMStr(d.time)) &&
        (!hasField(d, 'dateEnd') || d.dateEnd == null || isDateIsoStr(d.dateEnd)) &&
        (!hasField(d, 'timeEnd') || d.timeEnd == null || d.timeEnd == '' || isTimeHHMMStr(d.timeEnd)) &&
        (!hasField(d, 'description') || d.description is string) &&
        (!hasField(d, 'descriptionHtml') || isSafeRichText(d.descriptionHtml)) &&
        (!hasField(d, 'status') || d.status in ['marcado', 'adiado', 'cancelado', 'realizado']) &&
        (!hasField(d, 'publishStatus') || d.publishStatus in ['rascunho', 'publicado']) &&
        (!hasField(d, 'reminder1d') || d.reminder1d is bool) &&
        (!hasField(d, 'posterPath') || d.posterPath == null ||
          (d.posterPath is string && d.posterPath.matches('^posters/[^/]+\\.(jpg|png|webp)$'))) &&
        (!hasField(d, 'posterThumbPath') || d.posterThumbPath == null ||
          (d.posterThumbPath is string && d.posterThumbPath.matches('^posters/thumbs/[^/]+\\.(jpg|png|webp)$')));
    }
    function isValidAgendaItemDoc(d) {
      return d.keys().hasAll(['title', 'weekday', 'startTime']) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 140 &&
        d.weekday is int && d.weekday >= 1 && d.weekday <= 7 &&
        isTimeHHMMStr(d.startTime) &&
        (!hasField(d, 'endTime') || d.endTime == null || isTimeHHMMStr(d.endTime)) &&
        (!hasField(d, 'cancelledDates') || (d.cancelledDates is list && d.cancelledDates.size() <= 400)) &&
        (!hasField(d, 'location') || d.location is string) &&
        (!hasField(d, 'responsible') || d.responsible is string) &&
        (!hasField(d, 'notes') || d.notes is string);
    }

    match /announcements/{annId} {
      allow read, list: if isAuthenticated();
      allow create: if canPublishBoard() && isValidAnnouncementDoc(incoming());
      allow update: if canPublishBoard() && isValidAnnouncementDoc(incoming());
      allow delete: if canPublishBoard();
    }
    match /events/{eventId} {
      allow read, list: if isAuthenticated();
      allow create: if canPublishBoard() && isValidEventDoc(incoming());
      allow update: if canPublishBoard() && isValidEventDoc(incoming());
      allow delete: if canPublishBoard();
    }
    match /agenda_items/{itemId} {
      allow read, list: if isAuthenticated();
      allow create: if canPublishBoard() && isValidAgendaItemDoc(incoming());
      allow update: if canPublishBoard() && isValidAgendaItemDoc(incoming());
      allow delete: if canPublishBoard();
    }
    // --- v1.14.0: Auto-cadastro de membros (member_signups) --------------
    // Criado APENAS pelo Worker (conta de serviço — bypass de regras); nenhum
    // cliente cria pedidos directamente. O próprio lê o estado (ecrã de
    // pendente/rejeitado no login); a liderança gere; APROVAR/REJEITAR é só
    // do perfil 'admin' — verificado no SERVIDOR, não só no UI.
    match /member_signups/{signupId} {
      allow read, list: if isAuthenticated() &&
        (hasFinancialWriteAccess() || resource.data.email == request.auth.token.email);
      allow create: if false;
      allow update: if isAdmin() &&
        incoming().diff(resource.data).affectedKeys().hasOnly(
          ['statusSignup', 'reason', 'approvedBy', 'approvedAt', 'memberId', 'rejectedBy', 'rejectedAt']) &&
        incoming().statusSignup in ['pendente', 'aprovado', 'rejeitado'];
      allow delete: if isAdmin();
    }

    // Controlo do digest diário de notificações do módulo (só liderança).
    match /board_notify_log/{dayKey} {
      allow read, list: if canPublishBoard();
      allow create, update: if canPublishBoard() && isDateIsoStr(dayKey);
      allow delete: if canPublishBoard();
    }
    match /pedidos_atualizacao/{reqId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated() && incoming().memberId != null;
      allow update, delete: if isAdmin();
    }

    // --- Audit Logs Collection ---
    match /audit_logs/{logId} {
      allow read, list: if isAdmin();
      allow create: if hasFinancialWriteAccess();
      allow update, delete: if false;
    }

    // --- Support Messages Collection ---
    match /support_messages/{msgId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated() && incoming().senderId == request.auth.uid && incoming().text is string && incoming().text.size() > 0;
      allow update, delete: if isAdmin();
    }

    // --- WhatsApp Outbox Collection ---
    // Lixeira: moveToTrash/restoreFromTrash (lib/trash.ts). Sem este match,
    // TODAS as eliminações falhavam com permission-denied (varrimento 2026-10-24).
    match /trash/{trashId} {
      allow read, list: if hasFinancialWriteAccess();
      allow create: if hasFinancialWriteAccess() && isValidId(trashId)
                    && incoming().keys().hasAll(['collectionName', 'originalId', 'data', 'deletedAt', 'deletedBy']);
      allow update: if false;
      allow delete: if hasFinancialWriteAccess();
    }

    match /whatsapp_outbox/{msgId} {
      allow read, list: if isAdmin();
      allow create: if hasFinancialWriteAccess();
      allow update, delete: if isAdmin();
    }
  }
}